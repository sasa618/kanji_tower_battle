# タブ字下げ、UTF-8 BOM、CRLF
root = true

[*.{cpp,h}]
indent_style = tab
end_of_line = crlf
charset = utf-8-bom
insert_final_newline = true

# game・physics・main・draw・vec2 のほかは、空白4つで字下げする
[KanjiBlocks/{kanji,kanji_*,collection,editor,view,view_*,ui,asset,scene,scene_*,record,config}.{cpp,h}]
indent_style = space
indent_size = 4
